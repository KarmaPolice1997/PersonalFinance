<Window
    x:Class="AtomFinance.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Atom Finance"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Atom Finance">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- MAIN SHELL -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== PERSISTENT SIDEBAR ==================== -->
            <Border Grid.Column="0"
                    Background="{ThemeResource SurfaceBrush}"
                    BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Padding="0,24,0,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Atom Logo -->
                    <Button Grid.Row="0" x:Name="LogoBtn" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Padding="0">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <Grid Width="42" Height="32">
                                <Ellipse Width="24" Height="24" Fill="{ThemeResource TextPrimaryBrush}"/>
                                <Ellipse Width="38" Height="12" Stroke="{ThemeResource AccentPurpleBrush}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-22"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="Atom" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="24">
                        <!-- Dashboard -->
                        <Grid Height="44">
                            <Button x:Name="NavDashboardBtn" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTipService.ToolTip="Tổng quan (Dashboard)">
                                <FontIcon Glyph="&#xF0E2;" FontSize="18" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </Button>
                            <Border x:Name="IndicatorDashboard" Width="3" Height="24" Background="{ThemeResource AccentMintBrush}" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Transactions -->
                        <Grid Height="44">
                            <Button x:Name="NavTransactionsBtn" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTipService.ToolTip="Sổ giao dịch (Transactions)">
                                <FontIcon Glyph="&#xE9D2;" FontSize="18" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </Button>
                            <Border x:Name="IndicatorTransactions" Width="3" Height="24" Background="{ThemeResource AccentMintBrush}" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>

                        <!-- Accounts / Wallets -->
                        <Grid Height="44">
                            <Button x:Name="NavAccountsBtn" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTipService.ToolTip="Ví &amp; Tài khoản (Wallets)">
                                <FontIcon Glyph="&#xE8C7;" FontSize="18" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </Button>
                            <Border x:Name="IndicatorAccounts" Width="3" Height="24" Background="{ThemeResource AccentMintBrush}" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>

                        <!-- Settings -->
                        <Grid Height="44">
                            <Button x:Name="NavSettingsBtn" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTipService.ToolTip="Cài đặt &amp; Sao lưu (Settings)">
                                <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </Button>
                            <Border x:Name="IndicatorSettings" Width="3" Height="24" Background="{ThemeResource AccentMintBrush}" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>

                    <!-- Theme Toggle Quick Switch at Bottom -->
                    <Button Grid.Row="2" x:Name="ThemeToggleBtn"
                            Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Center"
                            ToolTipService.ToolTip="Đổi giao diện Sáng / Tối">
                        <FontIcon Glyph="&#xE706;" FontSize="18" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ==================== CONTENT FRAME ==================== -->
            <Frame x:Name="RootFrame" Grid.Column="1" Background="{ThemeResource AppBackgroundBrush}">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <EntranceNavigationTransitionInfo />
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </Grid>
    </Grid>
</Window>
