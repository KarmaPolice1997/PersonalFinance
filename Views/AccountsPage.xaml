<Page
    x:Class="AtomFinance.WinUI.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AtomFinance.WinUI.Models"
    NavigationCacheMode="Required"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid Padding="36,24,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Ví &amp; Tài khoản" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.TotalAssetsText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentPurpleTextBrush}"/>
            </StackPanel>

            <Button Command="{x:Bind ViewModel.AddAccountCommand}"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource TextPrimaryBrush}"
                    Foreground="{ThemeResource AppBackgroundBrush}"
                    CornerRadius="12" Padding="18,10" FontWeight="SemiBold" BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="13"/>
                    <TextBlock Text="Thêm ví / thẻ mới" FontSize="13"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Accounts Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="340" ItemHeight="190" MaximumRowsOrColumns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AccountItem">
                        <Border CornerRadius="18"
                                Padding="20,16"
                                Margin="0,0,16,16"
                                Background="{ThemeResource SurfaceCardBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                BorderThickness="1.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Name & Delete -->
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{x:Bind Name}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Click="OnDeleteClicked"
                                            Tag="{x:Bind Id}"
                                            Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Right" Padding="4"
                                            ToolTipService.ToolTip="Xóa thẻ / tài khoản">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- Balance & Description -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind BalanceText}"
                                               FontSize="22" FontWeight="Bold"
                                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Description}"
                                               FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                                               MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Footer: Type badge & Masked Number -->
                                <Grid Grid.Row="2">
                                    <Border Background="{ThemeResource AccentPurpleBgBrush}"
                                            CornerRadius="6" Padding="8,3"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind TypeName}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentPurpleTextBrush}"/>
                                    </Border>

                                    <TextBlock Text="{x:Bind MaskedNumber}"
                                               FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
