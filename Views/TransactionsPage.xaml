<Page
    x:Class="AtomFinance.WinUI.Views.TransactionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AtomFinance.WinUI.Models"
    NavigationCacheMode="Required"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid Padding="36,24,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Sổ giao dịch" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                <TextBlock Text="Quản lý và theo dõi toàn bộ các khoản thu, chi và chuyển khoản" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.ManageCategoriesCommand}"
                        Background="{ThemeResource AccentPurpleBgBrush}"
                        Foreground="{ThemeResource AccentPurpleTextBrush}"
                        CornerRadius="12" Padding="16,10" FontWeight="SemiBold" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8EC;" FontSize="13"/>
                        <TextBlock Text="Danh mục" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.AddTransactionCommand}"
                        Background="{ThemeResource TextPrimaryBrush}"
                        Foreground="{ThemeResource AppBackgroundBrush}"
                        CornerRadius="12" Padding="18,10" FontWeight="SemiBold" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="13"/>
                        <TextBlock Text="Ghi nhận giao dịch" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filter Ribbon & Search -->
        <Border Grid.Row="1"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16" Padding="18,14" Margin="0,0,0,16">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Filter Segment Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.SetFilterCommand}" CommandParameter="All"
                                Content="Tất cả" CornerRadius="8" Padding="14,6" FontSize="12" FontWeight="SemiBold"
                                BorderBrush="{ThemeResource AccentPurpleBrush}" BorderThickness="1"
                                Opacity="{x:Bind ViewModel.AllFilterOpacity, Mode=OneWay}"
                                Background="{ThemeResource AccentPurpleBgBrush}" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        <Button Command="{x:Bind ViewModel.SetFilterCommand}" CommandParameter="Expense"
                                Content="Chi tiêu" CornerRadius="8" Padding="14,6" FontSize="12" FontWeight="SemiBold"
                                BorderBrush="{ThemeResource AccentRedBrush}" BorderThickness="1"
                                Opacity="{x:Bind ViewModel.ExpenseFilterOpacity, Mode=OneWay}"
                                Background="{ThemeResource AccentRedBgBrush}" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        <Button Command="{x:Bind ViewModel.SetFilterCommand}" CommandParameter="Income"
                                Content="Thu nhập" CornerRadius="8" Padding="14,6" FontSize="12" FontWeight="SemiBold"
                                BorderBrush="{ThemeResource AccentMintBrush}" BorderThickness="1"
                                Opacity="{x:Bind ViewModel.IncomeFilterOpacity, Mode=OneWay}"
                                Background="{ThemeResource AccentMintBgBrush}" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        <Button Command="{x:Bind ViewModel.SetFilterCommand}" CommandParameter="Transfer"
                                Content="Chuyển khoản" CornerRadius="8" Padding="14,6" FontSize="12" FontWeight="SemiBold"
                                BorderBrush="{ThemeResource AccentPurpleBrush}" BorderThickness="1"
                                Opacity="{x:Bind ViewModel.TransferFilterOpacity, Mode=OneWay}"
                                Background="{ThemeResource SurfaceHighlightBrush}" Foreground="{ThemeResource TextPrimaryBrush}"/>

                        <!-- Filter Summary Label -->
                        <TextBlock Text="{x:Bind ViewModel.FilterSummaryText, Mode=OneWay}"
                                   FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- Search Box -->
                    <TextBox Grid.Column="1"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Tìm theo ghi chú, danh mục hoặc ví..."
                             Width="260" CornerRadius="8" VerticalAlignment="Center"/>
                </Grid>

                <!-- Account & Category Filter Combos -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                    <ComboBox ItemsSource="{x:Bind ViewModel.FilterAccounts, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.SelectedAccountFilterIndex, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              MinWidth="190"
                              CornerRadius="8"/>

                    <ComboBox ItemsSource="{x:Bind ViewModel.FilterCategories, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.SelectedCategoryFilterIndex, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              MinWidth="210"
                              CornerRadius="8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Virtualized Transactions List -->
        <Border Grid.Row="2"
                Background="{ThemeResource SurfaceCardBrush}"
                BorderBrush="{ThemeResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16" Padding="16">
            <ListView ItemsSource="{x:Bind ViewModel.Transactions, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionItem">
                        <Border Background="{ThemeResource SurfaceAltBrush}"
                                BorderBrush="{ThemeResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Badge Icon -->
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                        Background="{x:Bind BadgeBgBrush}"
                                        Margin="0,0,14,0">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15"
                                              Foreground="{x:Bind AmountBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Subtitle}"
                                               FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <!-- Amount -->
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind AmountText}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{x:Bind AmountBrush}"
                                           VerticalAlignment="Center"
                                           Margin="16,0,12,0"/>

                                <!-- Edit Button -->
                                <Button Grid.Column="3"
                                        Click="OnEditClicked"
                                        Tag="{x:Bind Id}"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="6" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Sửa giao dịch">
                                    <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                </Button>

                                <!-- Delete Button -->
                                <Button Grid.Column="4"
                                        Click="OnDeleteClicked"
                                        Tag="{x:Bind Id}"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="6" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Xóa giao dịch">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
