<Page
    x:Class="AtomFinance.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid Padding="36,24,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Cài đặt &amp; Dữ liệu" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                <TextBlock Text="Tùy chỉnh giao diện Sáng / Tối, sao lưu và bảo mật dữ liệu" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Settings Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
                <!-- Theme Card -->
                <Border Background="{ThemeResource SurfaceCardBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Giao diện hiển thị" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>

                        <StackPanel Spacing="10">
                            <RadioButton Content="Theo cài đặt Windows (Hệ thống)"
                                         IsChecked="{x:Bind IsThemeOptionSelected(ViewModel.SelectedThemeIndex, 0), Mode=OneWay}"
                                         Checked="OnThemeOptionChecked" Tag="0"
                                         Foreground="{ThemeResource TextPrimaryBrush}"/>
                            <RadioButton Content="Giao diện Sáng (White / Light Mode)"
                                         IsChecked="{x:Bind IsThemeOptionSelected(ViewModel.SelectedThemeIndex, 1), Mode=OneWay}"
                                         Checked="OnThemeOptionChecked" Tag="1"
                                         Foreground="{ThemeResource TextPrimaryBrush}"/>
                            <RadioButton Content="Giao diện Tối (Dark Mode)"
                                         IsChecked="{x:Bind IsThemeOptionSelected(ViewModel.SelectedThemeIndex, 2), Mode=OneWay}"
                                         Checked="OnThemeOptionChecked" Tag="2"
                                         Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Budget & Categories Card -->
                <Border Background="{ThemeResource SurfaceCardBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16" Padding="24">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Ngân sách &amp; Danh mục" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Header="Hạn mức chi tiêu tháng (VND)"
                                     PlaceholderText="Ví dụ: 15,000,000"
                                     Text="{x:Bind ViewModel.MonthlyBudgetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.SaveBudgetCommand}"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource TextPrimaryBrush}"
                                    Foreground="{ThemeResource AppBackgroundBrush}"
                                    CornerRadius="10" Padding="16,9" FontWeight="SemiBold" BorderThickness="0"
                                    Content="Lưu hạn mức"/>
                        </Grid>

                        <Button Command="{x:Bind ViewModel.ManageCategoriesCommand}"
                                Background="{ThemeResource AccentPurpleBgBrush}"
                                Foreground="{ThemeResource AccentPurpleTextBrush}"
                                CornerRadius="10" Padding="16,9" FontWeight="SemiBold" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8EC;" FontSize="13"/>
                                <TextBlock Text="Quản lý danh mục Thu / Chi..." FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Storage & Backup Card -->
                <Border Background="{ThemeResource SurfaceCardBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Cơ sở dữ liệu SQLite &amp; Sao lưu" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>

                        <Grid Margin="0,4,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Đường dẫn file CSDL" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.DatabasePath, Mode=OneWay}"
                                           FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Động cơ lưu trữ" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Text="Native Windows SQLite3 (winsqlite3.dll) — Zero Dependency" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,12,0,0">
                            <Button Command="{x:Bind ViewModel.BackupCommand}"
                                    Background="{ThemeResource TextPrimaryBrush}"
                                    Foreground="{ThemeResource AppBackgroundBrush}"
                                    CornerRadius="12" Padding="18,10" FontWeight="SemiBold" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEA35;" FontSize="13"/>
                                    <TextBlock Text="Sao lưu CSDL (.db)..." FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{x:Bind ViewModel.RestoreCommand}"
                                    Background="{ThemeResource AccentPurpleBgBrush}"
                                    Foreground="{ThemeResource AccentPurpleTextBrush}"
                                    CornerRadius="12" Padding="18,10" FontWeight="SemiBold" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                                    <TextBlock Text="Phục hồi dữ liệu..." FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- About Card -->
                <Border Background="{ThemeResource SurfaceCardBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16" Padding="24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Thông tin ứng dụng" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        <TextBlock Text="Atom Finance v2.0 (MVVM &amp; WinUI 3 Native)" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        <TextBlock Text="Thiết kế hiện đại, hỗ trợ chuyển đổi giao diện Sáng / Tối mượt mà, chuyển trang tức thì không giật lag và quản lý tài chính hiệu quả."
                                   FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
